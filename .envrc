# .envrc — direnv configuration for soopa_mono
#
# direnv (https://direnv.net) automatically loads this file on every `cd`
# into this directory, exporting all .env variables into the shell and all
# child processes — including those spawned by pnpm, make, uv, and IDEs.
#
# One-time setup per developer machine:
#   brew install direnv
#   echo 'eval "$(direnv hook zsh)"' >> ~/.zshrc   # or ~/.bashrc for bash
#   source ~/.zshrc                                  # reload current shell
#   direnv allow .                                   # trust this directory
#
# After that, every new terminal and every `cd` auto-loads .env.
# No `source .env`, no `if [ -f .env ]` guards, no check_env.sh needed.

dotenv_if_exists .env
