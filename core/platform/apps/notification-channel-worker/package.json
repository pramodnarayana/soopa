{
  "name": "@soopa/notification-channel-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "PYTHONUNBUFFERED=1 uv run python -m notification_channel_worker.main",
    "dev": "PYTHONUNBUFFERED=1 PYTHONPATH=src uv run python -m notification_channel_worker.main",
    "test": "echo 'No unit tests in this module'",
    "typecheck": "MYPYPATH=src uv run mypy --explicit-package-bases src",
    "test:integration": "uv run pytest tests/integration",
    "cov": "uv run pytest --cov=src --cov-report=term-missing --cov-fail-under=80 --ignore=tests/e2e"
  },
  "devDependencies": {
    "@soopa/notification": "workspace:*",
    "@soopa/pubsub": "workspace:*",
    "@soopa/database": "workspace:*",
    "@soopa/observability": "workspace:*"
  }
}
