{
  "name": "@soopa/notification-jobs-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "PYTHONUNBUFFERED=1 uv run python -m notification_jobs_worker.main",
    "dev": "PYTHONUNBUFFERED=1 PYTHONPATH=src uv run python -m notification_jobs_worker.main",
    "test": "uv run pytest tests/unit",
    "typecheck": "MYPYPATH=src uv run mypy --explicit-package-bases src",
    "test:integration": "uv run pytest tests/integration --cov=src",
    "cov": "uv run pytest -m \"not integration\" --cov=src --cov-report=term-missing --ignore=tests/integration --ignore=tests/e2e"
  },
  "devDependencies": {
    "@soopa/notification": "workspace:*",
    "@soopa/outbox": "workspace:*",
    "@soopa/pubsub": "workspace:*",
    "@soopa/database": "workspace:*",
    "@soopa/observability": "workspace:*"
  }
}
