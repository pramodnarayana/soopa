{
  "name": "@soopa/scheduler-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "PYTHONUNBUFFERED=1 uv run python -m scheduler_worker.main",
    "dev": "PYTHONUNBUFFERED=1 PYTHONPATH=src uv run python -m scheduler_worker.main",
    "test": "uv run pytest tests/unit",
    "typecheck": "MYPYPATH=src uv run mypy --explicit-package-bases src",
    "test:integration": "uv run pytest tests/integration",
    "cov": "uv run pytest --cov=src --cov-report=term-missing --cov-fail-under=80 --ignore=tests/e2e"
  }
}
