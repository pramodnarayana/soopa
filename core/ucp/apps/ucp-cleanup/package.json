{
  "name": "@soopa/ucp-cleanup",
  "private": true,
  "scripts": {
    "lint": "uv run ruff check .",
    "format": "uv run ruff format . && uv run ruff check --fix .",
    "typecheck": "uv run mypy src/ucp_cleanup",
    "test": "uv run pytest -m \"not integration\" --ignore=tests/integration --ignore=tests/e2e",
    "test:integration": "uv run pytest tests/integration",
    "deadcode:deptry": "uv run deptry .",
    "cov": "uv run pytest --cov=ucp_cleanup --cov-report=term-missing --cov-fail-under=80  --ignore=tests/e2e"
  }
}
