{
  "name": "@soopa/ucp",
  "private": true,
  "scripts": {
    "lint": "uv run ruff check .",
    "format": "uv run ruff format . && uv run ruff check --fix .",
    "typecheck": "uv run mypy src/ucp",
    "test": "uv run pytest -m \"not integration\" --ignore=tests/integration --ignore=tests/e2e",
    "deadcode:deptry": "uv run deptry .",
    "test:integration": "uv run pytest tests/integration --cov=src",
    "cov": "uv run pytest -m \"not integration\" --cov=src --cov-report=term-missing --ignore=tests/integration --ignore=tests/e2e"
  },
  "devDependencies": {
    "@soopa/ucp-models": "workspace:*",
    "@soopa/database": "workspace:*",
    "@soopa/identity": "workspace:*",
    "@soopa/outbox": "workspace:*",
    "@soopa/seedwork": "workspace:*",
    "@soopa/pubsub": "workspace:*"
  }
}
