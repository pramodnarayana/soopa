# EDI Orchestrator SQS Queues
EDI_DATABASE_URL=postgresql+asyncpg://edi:edi_password@localhost:5433/edi_shard
TEST_SHARD_DB_URL=postgresql+asyncpg://edi:edi_password@localhost:5433/edi_shard
# Override EDI shard URL: redirects from Docker-internal hostname to host-mapped port for local/CI use
SHARD_OVERRIDES__EDI_SHARD_1=postgresql+asyncpg://edi:edi_password@localhost:5433/edi_shard

# Integration Platform (IP) Database Shard
IP_DATABASE_URL=postgresql+asyncpg://ip:ip_password@localhost:5434/ip_shard
SHARD_OVERRIDES__IP_SHARD_1=postgresql+asyncpg://ip:ip_password@localhost:5434/ip_shard

# PostgreSQL Pub/Sub Queue URIs (UCP / Identity / Notification)
PUBSUB_TRANSPORT=db
SECRETS_BACKEND=file
SECRETS_MOUNT_PATH=.local/secrets
STORAGE_BACKEND=file
STORAGE_FILE_PATH=.local/storage
SQS_UCP_JOBS_QUEUE_URL=db://ucp-jobs.fifo
SQS_NOTIFICATION_JOBS_QUEUE_URL=db://notification-jobs.fifo
SQS_IDENTITY_JOBS_QUEUE_URL=db://identity-jobs.fifo
SQS_UCP_IDENTITY_SYNC_QUEUE_URL=db://ucp-events.fifo
SQS_IDENTITY_SYNC_QUEUE_URL=db://identity-events.fifo
SQS_EMAIL_CHANNEL_QUEUE_URL=db://email-channel.fifo
SQS_NOTIFICATION_QUEUE_URL=db://notifications.fifo

# Queue-Free Control Plane -> Data Plane HTTPS Dynamic Watch (EDI, IP, and future apps)
CONFIG_WATCH_BASE_URL=http://localhost:8081
CONFIG_SYNC_INTERNAL_TOKEN=dev-internal-config-sync-token

# PostgreSQL Pub/Sub Queue URIs (EDI — Data Plane drains shard `public.outbox` directly)
SQS_ORCHESTRATOR_QUEUE_URL=db://edi-orchestrator
SQS_COMPUTE_QUEUE_URL=db://edi-compute
SQS_DATA_PLANE_JOBS_QUEUE_URL=db://edi-data-plane-jobs.fifo
SQS_CONTROL_PLANE_JOBS_QUEUE_URL=db://edi-control-plane-jobs.fifo
SQS_DELIVER_QUEUE_URL=db://edi-deliver
SQS_DELIVER_DLQ_URL=db://edi-deliver-dlq

# PostgreSQL Pub/Sub Queue URIs (IP — Data Plane drains shard `public.ip_outbox` directly)
SQS_IP_ORCHESTRATOR_REALTIME_QUEUE_URL=db://ip-orchestrator-realtime
SQS_IP_ORCHESTRATOR_BULK_QUEUE_URL=db://ip-orchestrator-bulk
SQS_IP_DELIVERY_REALTIME_QUEUE_URL=db://ip-delivery-realtime
SQS_IP_DELIVERY_BULK_QUEUE_URL=db://ip-delivery-bulk
SQS_IP_CONTROL_PLANE_JOBS_QUEUE_URL=db://ip-control-plane-jobs.fifo
SQS_IP_DATA_PLANE_JOBS_QUEUE_URL=db://ip-data-plane-jobs.fifo

# PostgreSQL Pub/Sub Topic URIs (`pubsub.platform_topic_subscriptions`)
SNS_PLATFORM_EVENTS_TOPIC_ARN=db://topic/platform-events-topic
SNS_IP_EVENTS_TOPIC_ARN=db://topic/ip-events-topic


# Dashboard Vite Frontend
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_UCP_API_URL=http://localhost:3000
VITE_IDENTITY_API_URL=http://localhost:8080
VITE_IDENTITY_UCP_WEB_CLIENT_ID=soopa_dashboard_local
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3001","http://localhost:3000"]

# Allow private IPs in test/dev for AS2 and local Casdoor IdP
EDI_ALLOW_PRIVATE_IPS=true
IDENTITY_ALLOW_PRIVATE_IPS=true

# Cloud-Agnostic Storage & Secret Store Configuration (s3 | minio | file | filesystem | nfs | posix)
STORAGE_BACKEND=file
STORAGE_FILE_PATH=/tmp/soopa-storage
# Secrets Backend (aws | file | kubernetes | vault)
SECRETS_BACKEND=file
SECRETS_MOUNT_PATH=/tmp/soopa-secrets
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT=secret
VAULT_NAMESPACE=

# EDI Environment
EDI_ENVIRONMENT=T
