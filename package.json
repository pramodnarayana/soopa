{
  "name": "soopa-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Soopa Enterprise Unified Platform",
  "scripts": {
    "dev": "concurrently --handle-input --kill-signal SIGINT --kill-others -c \"green,blue,cyan,magenta,yellow,white\" -n \"turbo,ucp,edi-api,edi-as2,edi-orch,edi-compute\" \"turbo run dev start:dev --log-order=stream\" \"cd core/ucp/apps/ucp-api && PYTHONPATH=src uv run uvicorn ucp_api.main:app --port 3000 --reload --env-file ../../../../.env\" \"cd apps/edi && make dev-api\" \"cd apps/edi && make dev-as2\" \"cd apps/edi && make dev-worker-orchestrator\" \"cd apps/edi && make dev-worker-compute\"",
    "start:prd": "turbo run build && turbo run start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "typecheck:tests": "turbo run typecheck:tests",
    "lint": "turbo run lint",
    "test": "pnpm test:node && pnpm test:python",
    "test:node": "DATABASE_URL=\"postgresql://ucp_admin:ucp_password@localhost:5432/ucp_global\" SHARD_1_URL=\"postgresql://edi:edi_password@localhost:5433/edi_shard_1\" CI=true turbo run test --filter=\"!*@soopa/api\" --filter=\"!*@soopa/*-worker\" --filter=\"!*@soopa/domain\" --filter=\"!*@soopa/database\" --filter=\"!*@soopa/*-engine\"",
    "test:python": "export DATABASE_URL=\"postgresql+asyncpg://ucp_admin:ucp_password@localhost:5432/ucp_global\" SHARD_1_URL=\"postgresql+asyncpg://edi:edi_password@localhost:5433/edi_shard_1\"; turbo run test --filter=\"*@soopa/api\" --filter=\"*@soopa/*-worker\" --filter=\"*@soopa/domain\" --filter=\"*@soopa/database\" --filter=\"*@soopa/*-engine\"",
    "cov:python": "export DATABASE_URL=\"postgresql+asyncpg://ucp_admin:ucp_password@localhost:5432/ucp_global\" SHARD_1_URL=\"postgresql+asyncpg://edi:edi_password@localhost:5433/edi_shard_1\"; turbo run cov",
    "knip": "knip",
    "db:generate": "cd core/platform/packages/orm && uv run alembic revision --autogenerate",
    "db:migrate": "pnpm db:migrate:platform && pnpm db:migrate:edi",
    "db:migrate:platform": "cd core/platform/packages/orm && uv run alembic upgrade head",
    "db:migrate:edi": "cd apps/edi/packages/database && uv run python src/database/run_migrations.py",
    "db:seed": "pnpm --filter @soopa/database db:seed",
    "db:clear-zitadel": "pnpm --filter @soopa/database db:clear-zitadel",
    "infra:phase1-cleanup": "pnpm db:clear-zitadel",
    "infra:phase2-teardown": "docker compose down -v --remove-orphans",
    "infra:phase3-bootstrap": "docker compose up -d --wait postgres_global edi_postgres_shard_1 localstack debezium_shard_1 vault cdcproxy && pnpm db:migrate && pnpm db:seed",
    "infra:phase4-init-edi": "cd apps/edi && make sqs-purge db-init",
    "infra:start-identity": "docker compose --env-file .env -f core/ucp/docker-compose.yml up -d",
    "infra:sync-identity": "tsx core/ucp/infra/zitadel/sync.ts",
    "infra-reset": "pnpm infra:phase1-cleanup && pnpm infra:phase2-teardown && pnpm infra:phase3-bootstrap && pnpm infra:phase4-init-edi",
    "ucp-reset": "pnpm infra:phase1-cleanup && pnpm infra:phase2-teardown && pnpm infra:phase3-bootstrap",
    "soft-reset": "pnpm infra:phase1-cleanup && cd apps/edi && make sqs-purge",
    "data-reset": "cd apps/edi && make clear-data",
    "clean": "turbo clean && rm -rf node_modules",
    "prepare": "husky",
    "deadcode": "turbo run deadcode",
    "format": "turbo run format",
    "syncpack:format": "syncpack format",
    "syncpack:lint": "syncpack lint",
    "syncpack:fix": "syncpack fix"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.1.2",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "lint-staged": "^17.2.0",
    "syncpack": "^15.3.2",
    "tsx": "^4.23.1",
    "turbo": "^2.7.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  }
}
