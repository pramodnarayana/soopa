{
  "name": "soopa-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Soopa Enterprise Unified Platform",
  "scripts": {
    "dev": "turbo run dev start:dev --concurrency=20",
    "start:prd": "turbo run build && turbo run start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "typecheck:tests": "turbo run typecheck:tests",
    "lint": "turbo run lint",
    "test": "pnpm test:node && pnpm test:python",
    "verify:ci": "./scripts/verify_ci.sh",
    "test:integration": "turbo run test:integration --filter=\"*@soopa/api\" --filter=\"@soopa/unified-api\" --filter=\"*@soopa/*-worker\" --filter=\"*@soopa/*-cleanup\" --filter=\"*@soopa/domain\" --filter=\"*@soopa/database\" --filter=\"*@soopa/*-engine\" --filter=\"*@soopa/ucp*\" --filter=\"*@soopa/identity\" --filter=\"*@soopa/notification\" --filter=\"*@soopa/scheduler*\" --filter=\"*@soopa/observability\" --filter=\"*@soopa/database\" --filter=\"*@soopa/schemas\"",
    "test:mutation": "stryker run",
    "test:node": "CI=true turbo run test --concurrency=2 --filter=\"!*@soopa/api\" --filter=\"!*@soopa/*-worker\" --filter=\"!*@soopa/*-cleanup\" --filter=\"!*@soopa/domain\" --filter=\"!*@soopa/database\" --filter=\"!*@soopa/*-engine\" --filter=\"!*@soopa/ucp*\" --filter=\"!*@soopa/identity\" --filter=\"!*@soopa/notification\" --filter=\"!*@soopa/scheduler*\" --filter=\"!*@soopa/observability\" --filter=\"!*@soopa/database\" --filter=\"!*@soopa/schemas\"",
    "test:python": "turbo run test --concurrency=2 --filter=\"*@soopa/api\" --filter=\"*@soopa/*-worker\" --filter=\"*@soopa/*-cleanup\" --filter=\"*@soopa/domain\" --filter=\"*@soopa/database\" --filter=\"*@soopa/*-engine\" --filter=\"*@soopa/ucp*\" --filter=\"*@soopa/identity\" --filter=\"*@soopa/notification\" --filter=\"*@soopa/scheduler*\" --filter=\"*@soopa/observability\" --filter=\"*@soopa/database\" --filter=\"*@soopa/schemas\"",
    "cov:python": "turbo run cov --filter=\"*@soopa/api\" --filter=\"*@soopa/*-worker\" --filter=\"*@soopa/*-cleanup\" --filter=\"*@soopa/domain\" --filter=\"*@soopa/database\" --filter=\"*@soopa/*-engine\" --filter=\"*@soopa/ucp*\" --filter=\"*@soopa/identity\" --filter=\"*@soopa/notification\" --filter=\"*@soopa/scheduler*\" --filter=\"*@soopa/observability\" --filter=\"*@soopa/database\" --filter=\"*@soopa/schemas\"",
    "knip": "knip",
    "db:generate": "cd core/platform/packages/database && uv run alembic revision --autogenerate",
    "db:migrate": "pnpm db:migrate:platform && pnpm db:migrate:edi",
    "db:migrate:platform": "cd core/platform/packages/database && uv run alembic upgrade head",
    "db:migrate:edi": "cd apps/edi/packages/edi && uv run python src/edi/adapters/outbound/database/run_migrations.py",
    "db:seed": "cd core/ucp/packages/ucp && uv run python scripts/seed.py",
    "infra:clean-identity": "cd core/ucp/packages/ucp && uv run python scripts/clear_zitadel.py",
    "infra:down": "docker compose down -v --remove-orphans",
    "infra:up": "docker compose up -d --wait postgres_global edi_postgres_shard localstack debezium_shard otel-collector sftp && pnpm db:migrate:platform && pnpm db:seed && pnpm db:migrate:edi",
    "infra:init-edi": "cd apps/edi && make sqs-purge db-init",
    "infra-reset": "pnpm infra:down && pnpm infra:up && pnpm infra:init-edi",
    "infra:start-identity": "docker compose --env-file .env -f core/ucp/docker-compose.yml up -d",
    "infra:sync-identity": "tsx infra/cloud/zitadel/sync.ts",
    "infra-restart": "docker compose restart postgres_global edi_postgres_shard localstack debezium_shard cdcproxy otel-collector",
    "platform:build": "docker compose --profile build run --rm platform-builder",
    "platform:up": "pnpm platform:build && docker compose up -d unified-api edi-as2-server edi-orchestrator edi-compute-worker edi-config-sync-worker edi-cp-outbox-worker edi-dp-outbox-worker edi-cp-cleanup edi-dp-cleanup ucp-worker ucp-outbox-worker ucp-cleanup identity-worker identity-outbox-worker identity-cleanup notification-worker notification-outbox-worker notification-email-worker notification-cleanup scheduler-engine",
    "platform:down": "docker compose stop unified-api edi-as2-server edi-orchestrator edi-compute-worker edi-config-sync-worker edi-cp-outbox-worker edi-dp-outbox-worker edi-cp-cleanup edi-dp-cleanup ucp-worker ucp-outbox-worker ucp-cleanup identity-worker identity-outbox-worker identity-cleanup notification-worker notification-outbox-worker notification-email-worker notification-cleanup scheduler-engine",
    "ucp-reset": "pnpm infra:clean-identity && pnpm infra:down && pnpm infra:up",
    "soft-reset": "pnpm infra:clean-identity && cd apps/edi && make sqs-purge",
    "data-reset": "cd apps/edi && make clear-data",
    "clean": "turbo clean && rm -rf node_modules",
    "prepare": "husky",
    "deadcode": "uv run vulture",
    "format": "turbo run format",
    "syncpack:format": "syncpack format",
    "syncpack:lint": "syncpack lint",
    "syncpack:fix": "syncpack fix"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "syncpack": "^15.3.3",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.12",
      "hono": "^4.13.5",
      "js-yaml": "^4.3.2",
      "undici": "^7.29.0",
      "@hono/node-server": "^1.19.15",
      "fast-uri": "^3.1.6",
      "qs": "^6.16.0",
      "vite>esbuild": "^0.28.1"
    }
  }
}
