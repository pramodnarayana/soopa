#!/bin/sh
set -e
export DATABASE_URL="postgresql://ucp_admin:ucp_password@localhost:5432/ucp_global"
export SHARD_1_URL="postgresql://edi:edi_password@localhost:5433/edi_shard_1"

echo "[pre-commit] Checking if database is running..."
if ! docker ps | grep -q "postgres_global"; then
  echo "ERROR: Local database is not running. Please start it to run local tests."
  echo "Run: docker compose up -d postgres_global edi_postgres_shard_1 --wait"
  exit 1
fi

echo "[pre-commit] Running formatting..."
npx lint-staged
uvx pre-commit run

echo "[pre-commit] Running typechecks (Cached)..."
pnpm turbo typecheck
pnpm turbo typecheck:tests

echo "[pre-commit] Pre-commit checks passed! 🚀"
