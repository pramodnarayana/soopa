#!/bin/sh
set -e

echo "[pre-commit] Running fast staged-file checks..."
npx lint-staged

if git diff --cached --name-only | grep -qE '(^|/)(pyproject\.toml|package\.json)$'; then
  echo "[pre-commit] Validating Python workspace dependency synchronization..."
  pnpm run syncpack:python:check
fi

echo "[pre-commit] Staged checks passed!"
