{
  "topics": [],
  "queues": [
    {
      "name": "edi-config-sync-queue",
      "fifo": true,
      "dlq": true,
      "env_var": "SQS_PROVISIONING_QUEUE_URL"
    },
    {
      "name": "edi-orchestrator",
      "fifo": false,
      "dlq": true,
      "env_var": "SQS_ORCHESTRATOR_QUEUE_URL"
    },
    { "name": "edi-compute", "fifo": false, "dlq": true, "env_var": "SQS_COMPUTE_QUEUE_URL" },
    {
      "name": "edi-data-plane-jobs",
      "fifo": true,
      "dlq": true,
      "env_var": "SQS_DATA_PLANE_JOBS_QUEUE_URL"
    },
    {
      "name": "edi-control-plane-jobs",
      "fifo": true,
      "dlq": true,
      "env_var": "SQS_CONTROL_PLANE_JOBS_QUEUE_URL"
    },
    {
      "name": "edi-deliver",
      "fifo": false,
      "dlq": true,
      "env_var": "SQS_DELIVER_QUEUE_URL",
      "dlq_env_var": "SQS_DELIVER_DLQ_URL",
