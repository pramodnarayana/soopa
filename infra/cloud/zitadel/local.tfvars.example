# Explicit local-only values. Use with:
# terraform apply -var-file=local.tfvars.example
#
# Cloud workspaces must provide their own HTTPS endpoints and keep insecure and
# dev mode disabled.
idp_project_name = "Soopaidp"
zitadel_domain   = "ucp.localhost"
zitadel_port     = "8080"
zitadel_insecure = true

ucp_web_dashboard_redirect_uris = [
  "http://localhost:5173/auth/callback",
  "http://localhost:5173/callback",
]
ucp_web_dashboard_post_logout_redirect_uris = [
  "http://localhost:5173",
  "http://localhost:5173/",
]
dev_mode = true
