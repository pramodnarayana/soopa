{
  "topics": [
    {
      "name": "platform-events-topic",
      "fifo": true,
      "env_var": "SNS_PLATFORM_EVENTS_TOPIC_ARN"
    },
    {
      "name": "ip-events-topic",
      "fifo": false,
      "env_var": "SNS_IP_EVENTS_TOPIC_ARN"
    }
  ],
  "queues": [
    {
      "name": "ucp-jobs",
      "fifo": true,
      "dlq": true,
      "env_var": "SQS_UCP_JOBS_QUEUE_URL"
    },
    {
      "name": "notification-jobs",
      "fifo": true,
      "dlq": true,
      "env_var": "SQS_NOTIFICATION_JOBS_QUEUE_URL"
    },
    {
      "name": "identity-jobs",
      "fifo": true,
      "dlq": true,
      "env_var": "SQS_IDENTITY_JOBS_QUEUE_URL"
    },
    {
      "name": "ucp-events",
      "fifo": true,
      "dlq": true,
      "env_var": "SQS_UCP_IDENTITY_SYNC_QUEUE_URL"
    },
    {
      "name": "identity-events",
      "fifo": true,
      "dlq": true,
      "env_var": "SQS_IDENTITY_SYNC_QUEUE_URL"
    },
    {
      "name": "email-channel",
      "fifo": true,
      "dlq": true,
      "env_var": "SQS_EMAIL_CHANNEL_QUEUE_URL"
    },
    {
      "name": "edi-config-sync-queue",
      "fifo": true,
      "dlq": true,
      "env_var": "SQS_PROVISIONING_QUEUE_URL"
    },
    {
      "name": "edi-orchestrator",
      "fifo": false,
      "dlq": true,
      "env_var": "SQS_ORCHESTRATOR_QUEUE_URL"
    },
    {
      "name": "edi-compute",
      "fifo": false,
      "dlq": true,
      "env_var": "SQS_COMPUTE_QUEUE_URL"
    },
    {
      "name": "edi-data-plane-jobs",
      "fifo": true,
      "dlq": true,
      "env_var": "SQS_DATA_PLANE_JOBS_QUEUE_URL"
    },
    {
      "name": "edi-control-plane-jobs",
      "fifo": true,
      "dlq": true,
      "env_var": "SQS_CONTROL_PLANE_JOBS_QUEUE_URL"
    },
    {
      "name": "edi-deliver",
      "fifo": false,
      "dlq": true,
      "env_var": "SQS_DELIVER_QUEUE_URL",
      "dlq_env_var": "SQS_DELIVER_DLQ_URL",
      "max_receive_count": 3
    },
    {
      "name": "edi-priority-notifications",
      "fifo": true,
      "dlq": true,
      "env_var": "SQS_PRIORITY_NOTIFICATIONS_QUEUE_URL"
    },
    {
      "name": "ip-orchestrator-realtime",
      "fifo": false,
      "dlq": true,
      "env_var": "SQS_IP_ORCHESTRATOR_REALTIME_QUEUE_URL"
    },
    {
      "name": "ip-orchestrator-bulk",
      "fifo": false,
      "dlq": true,
      "env_var": "SQS_IP_ORCHESTRATOR_BULK_QUEUE_URL"
    },
    {
      "name": "ip-delivery-realtime",
      "fifo": false,
      "dlq": true,
      "env_var": "SQS_IP_DELIVERY_REALTIME_QUEUE_URL"
    },
    {
      "name": "ip-delivery-bulk",
      "fifo": false,
      "dlq": true,
      "env_var": "SQS_IP_DELIVERY_BULK_QUEUE_URL"
    },
    {
      "name": "ip-control-plane-jobs",
      "fifo": true,
      "dlq": true,
      "env_var": "SQS_IP_CONTROL_PLANE_JOBS_QUEUE_URL"
    },
    {
      "name": "ip-data-plane-jobs",
      "fifo": true,
      "dlq": true,
      "env_var": "SQS_IP_DATA_PLANE_JOBS_QUEUE_URL"
    }
  ],
  "subscriptions": [
    {
      "topic": "platform-events-topic",
      "queue": "ucp-events",
      "filterPolicy": {
        "event_type": [
          {
            "prefix": "app."
          },
          {
            "prefix": "tenant."
          }
        ]
      }
    },
    {
      "topic": "platform-events-topic",
      "queue": "identity-events",
      "filterPolicy": {
        "event_type": [
          {
            "prefix": "tenant."
          },
          {
            "prefix": "app."
          },
          {
            "prefix": "user."
          }
        ]
      }
    },
    {
      "topic": "platform-events-topic",
      "queue": "edi-config-sync-queue",
      "filterPolicy": {
        "event_type": [
          {
            "prefix": "webhook."
          },
          {
            "prefix": "edi."
          }
        ]
      }
    }
  ],
  "buckets": [
    {
      "name": "observability-data"
    },
    {
      "name": "ip-payloads"
    }
  ],
  "secrets": [
    {
      "name": "edi/edi-shard-db-credentials",
      "mockValue": "{\"host\":\"postgres-global\",\"port\":5432,\"username\":\"postgres\",\"password\":\"postgres\",\"dbname\":\"edi_shard\"}"
    },
    {
      "name": "edi/as2-certificates",
      "mockValue": "{}"
    },
    {
      "name": "ip/ip-shard-db-credentials",
      "mockValue": "{\"host\":\"ip_postgres_shard\",\"port\":5432,\"username\":\"ip\",\"password\":\"ip_password\",\"dbname\":\"ip_shard\"}"
    }
  ]
}
