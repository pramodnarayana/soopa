{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start:dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "VITE_API_PROXY_TARGET",
        "VITE_UCP_API_URL",
        "IDENTITY_API_URL",
        "IDENTITY_UCP_WEB_CLIENT_ID",
        "IDENTITY_UCP_PROJECT_ID"
      ],
      "outputs": ["dist/**"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "test": {
      "dependsOn": ["build"],
      "env": ["DATABASE_URL", "DB_SHARD_1_URL", "SHARD_1_URL"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["build"],
      "env": ["DATABASE_URL", "DB_SHARD_1_URL", "SHARD_1_URL"],
      "outputs": []
    },
    "cov": {
      "dependsOn": ["build"],
      "env": ["DATABASE_URL", "DB_SHARD_1_URL", "SHARD_1_URL"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck:tests": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "deadcode:deptry": {
      "outputs": []
    }
  }
}
