{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "SOOPA_ENV_FILE",
    "PYTEST_PLUGINS",
    "COVERAGE_FILE",
    "CI",
    "ENVIRONMENT",
    "ENABLED_APPS",
    "*_DATABASE_URL",
    "TEST_SHARD_DB_URL",
    "SHARD_OVERRIDES__*",
    "DATABASE__*",
    "AWS_*",
    "SQS_*",
    "SNS_*",
    "S3_*",
    "IDENTITY_*",
    "ZITADEL_*",
    "SECRETS_*",
    "STORAGE_*",
    "AS2_*",
    "SFTP_*",
    "ENCRYPTION_*",
    "VAULT_*",
    "MASTER_KEY*",
    "OTEL_*"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start:dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "test": {
      "dependsOn": ["build"],
      "env": ["DATABASE_URL", "DB_SHARD_1_URL", "SHARD_1_URL"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["build"],
      "env": ["DATABASE_URL", "DB_SHARD_1_URL", "SHARD_1_URL"],
      "outputs": [".coverage.integration", ".coverage"]
    },
    "cov": {
      "dependsOn": ["build"],
      "env": ["DATABASE_URL", "DB_SHARD_1_URL", "SHARD_1_URL"],
      "outputs": [".coverage.unit", ".coverage"]
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck:tests": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "deadcode:deptry": {
      "outputs": []
    }
  }
}
